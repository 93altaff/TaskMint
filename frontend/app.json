{
  "expo": {
    "name": "TaskMint",
    "slug": "taskmint",
    "version": "1.0.4",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "taskmint",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#4F46E5"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.labs93world.taskmint",
      "infoPlist": {
        "NSUserTrackingUsageDescription": "Show personalised rewards and offers",
        "NSPhotoLibraryUsageDescription": "Upload photos to submit task proof"
      }
    },
    "android": {
      "package": "com.labs93world.taskmint",
      "versionCode": 4,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#4F46E5"
      },
      "edgeToEdgeEnabled": true,
      "permissions": [
        "INTERNET",
        "ACCESS_NETWORK_STATE",
        "POST_NOTIFICATIONS"
      ],
      "splash": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#4F46E5",
        "mdpi": "./assets/images/splash-icon.png",
        "hdpi": "./assets/images/splash-icon.png",
        "xhdpi": "./assets/images/splash-icon.png",
        "xxhdpi": "./assets/images/splash-icon.png",
        "xxxhdpi": "./assets/images/splash-icon.png"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#4F46E5",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#4F46E5"
          },
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "resizeMode": "contain",
            "backgroundColor": "#4F46E5"
          }
        }
      ],
      "expo-web-browser",
      [
        "expo-navigation-bar",
        {
          "visibility": "hidden",
          "behavior": "overlay-swipe"
        }
      ],
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-7744865309171344~1346257321",
          "iosAppId": "ca-app-pub-7744865309171344~1346257321",
          "userTrackingUsageDescription": "This identifier will be used to deliver personalised ads to you."
        }
      ],
      "expo-font",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "admob": {
        "appId": "ca-app-pub-7744865309171344~1346257321",
        "banner": "ca-app-pub-7744865309171344/7215240687",
        "native": "ca-app-pub-7744865309171344/5951555040",
        "interstitial": "ca-app-pub-7744865309171344/9409414321",
        "rewarded": "ca-app-pub-7744865309171344/8895153865"
      }
    }
  }
}
